DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
BIND_ADDR=0.0.0.0:8080
# Bearer token required on every /v1 endpoint except the M-Pesa webhook
API_KEY=change-me-dev-key
# Secret path segment for the Daraja callback URL: /v1/webhooks/mpesa/<token>
MPESA_WEBHOOK_TOKEN=change-me-webhook-token
WORKER_INTERVAL_MS=1000
MAX_CALLBACK_ATTEMPTS=8
RUST_LOG=info,ledgerd=debug,tower_http=info
